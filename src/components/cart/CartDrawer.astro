---
import { LOCATIONS, PRIMARY_LOCATION } from '../../data/site';
import { MAX_QTY } from '../../lib/cart';
import { storeHref } from '../../lib/url';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';

// Sede por defecto primero
const branches = [PRIMARY_LOCATION, ...LOCATIONS.filter((l) => l.id !== PRIMARY_LOCATION.id)];
---

<p class="visually-hidden" role="status" aria-live="polite" data-cart-live></p>

<dialog id="cart-drawer" class="drawer" aria-labelledby="cart-title" data-max-qty={MAX_QTY}>
  <div class="drawer__panel">
    <header class="drawer__head">
      <h2 id="cart-title">Tu pedido <span class="drawer__count" data-cart-count-label></span></h2>
      <button class="drawer__close" type="button" data-cart-close aria-label="Cerrar carrito">
        <Icon name="close" size={24} />
      </button>
    </header>

    <div class="drawer__body">
      <div class="drawer__empty" data-cart-empty>
        <Icon name="cart" size={44} />
        <p><strong>Tu carrito está vacío.</strong></p>
        <p>Agregá productos y armamos el pedido por WhatsApp.</p>
        <Button variant="primary" href={storeHref()} data-cart-close>Ver productos</Button>
      </div>
      <ul class="drawer__list" data-cart-list></ul>
    </div>

    <footer class="drawer__foot" data-cart-foot hidden>
      <div class="drawer__total">
        <span>Total estimado</span>
        <strong data-cart-total></strong>
      </div>
      <p class="drawer__note">Precios de ejemplo. Stock, precio final y entrega se confirman por WhatsApp.</p>

      <label class="drawer__branch">
        <span>Enviar el pedido a</span>
        <select data-cart-branch>
          {branches.map((b) => (<option value={b.whatsapp}>{b.name}</option>))}
        </select>
      </label>

      <a class="btn-checkout" data-cart-checkout href="#" target="_blank" rel="noopener">
        <Icon name="whatsapp" size={22} /> Enviar pedido por WhatsApp
      </a>
      <button class="drawer__clear" type="button" data-cart-clear>Vaciar carrito</button>
    </footer>
  </div>
</dialog>

<template id="cart-row-template">
  <li class="row">
    <img class="row__img" alt="" width="60" height="48" loading="lazy" />
    <div class="row__info">
      <p class="row__name"></p>
      <p class="row__unit"></p>
      <div class="row__qty">
        <button type="button" data-qty-dec><Icon name="minus" size={16} /></button>
        <output class="row__n"></output>
        <button type="button" data-qty-inc><Icon name="plus" size={16} /></button>
      </div>
    </div>
    <div class="row__side">
      <p class="row__price"></p>
      <button class="row__remove" type="button" data-remove><Icon name="trash" size={18} /></button>
    </div>
  </li>
</template>

<style is:global>
  html:has(dialog.drawer[open]) { overflow: hidden; }

  dialog.drawer { margin: 0 0 0 auto; padding: 0; border: 0; width: min(26rem, 100vw); max-width: 100vw; height: 100dvh; max-height: 100dvh; background: #fff; color: var(--ink); box-shadow: -12px 0 40px rgb(15 27 45 / 25%); transform: translateX(100%); transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1), overlay 0.3s allow-discrete, display 0.3s allow-discrete; }
  dialog.drawer[open] { transform: translateX(0); }
  @starting-style { dialog.drawer[open] { transform: translateX(100%); } }
  dialog.drawer::backdrop { background: rgb(15 27 45 / 0%); transition: background-color 0.3s ease, overlay 0.3s allow-discrete, display 0.3s allow-discrete; }
  dialog.drawer[open]::backdrop { background: rgb(15 27 45 / 55%); }
  @starting-style { dialog.drawer[open]::backdrop { background: rgb(15 27 45 / 0%); } }

  .drawer__panel { display: flex; flex-direction: column; height: 100%; }
  .drawer__head { display: flex; align-items: center; justify-content: space-between; padding: 0.9rem 1rem 0.9rem 1.25rem; border-bottom: 1px solid var(--line); }
  .drawer__head h2 { font-size: 1.7rem; text-transform: uppercase; color: var(--blue-dark); }
  .drawer__count { color: var(--ink-2); font-size: 1.1rem; }
  .drawer__close { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 0; background: transparent; border-radius: var(--radius-sm); cursor: pointer; color: var(--ink); }
  .drawer__close:hover { background: var(--bg-alt); }

  .drawer__body { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 0.5rem 1.25rem; }
  .drawer__empty { display: grid; justify-items: center; gap: 0.6rem; text-align: center; padding: 3rem 1rem; color: var(--ink-2); }
  .drawer__empty svg { color: var(--blue); }
  .drawer__empty strong { color: var(--ink); font-size: var(--fs-lg); }
  .drawer__empty .btn { margin-top: 0.5rem; }
  .drawer__list:empty, .drawer__list[hidden] { display: none; }

  .row { display: grid; grid-template-columns: 3.75rem 1fr auto; gap: 0.8rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); align-items: start; }
  .row__img { width: 3.75rem; height: 3rem; object-fit: contain; border: 1px solid var(--line); border-radius: 6px; background: #fff; }
  .row__name { font-weight: 700; line-height: 1.25; }
  .row__unit { color: var(--ink-2); font-size: var(--fs-sm); }
  .row__qty { display: inline-flex; align-items: center; margin-top: 0.5rem; border: 1px solid var(--line); border-radius: 999px; }
  .row__qty button { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 0; background: transparent; border-radius: 50%; cursor: pointer; color: var(--blue-dark); }
  .row__qty button:hover:not(:disabled) { background: var(--blue-tint); }
  .row__qty button:disabled { opacity: 0.35; cursor: not-allowed; }
  .row__n { min-width: 1.75rem; text-align: center; font-weight: 700; font-variant-numeric: tabular-nums; }
  .row__side { display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; }
  .row__price { font-family: var(--font-display); font-weight: 800; font-size: 1.3rem; white-space: nowrap; }
  .row__remove { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 0; background: transparent; color: var(--ink-2); border-radius: var(--radius-sm); cursor: pointer; }
  .row__remove:hover { background: #fde8e8; color: #b42318; }

  .drawer__foot { padding: 1rem 1.25rem calc(1rem + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: var(--bg-alt); display: grid; gap: 0.6rem; }
  .drawer__foot[hidden] { display: none; }
  .drawer__total { display: flex; align-items: baseline; justify-content: space-between; }
  .drawer__total strong { font-family: var(--font-display); font-size: 2rem; font-weight: 800; }
  .drawer__note { font-size: 0.8125rem; color: var(--ink-2); }
  .drawer__branch { display: grid; gap: 0.25rem; font-size: var(--fs-sm); font-weight: 600; }
  .drawer__branch select { min-height: 2.75rem; padding: 0 0.75rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: #fff; font: inherit; font-weight: 500; color: var(--ink); }
  .btn-checkout { display: flex; align-items: center; justify-content: center; gap: 0.55rem; min-height: 3.25rem; border-radius: 999px; background: var(--wa); color: #06210f; font-weight: 700; font-size: var(--fs-lg); text-decoration: none; }
  .btn-checkout:hover { background: #3be07a; }
  .drawer__clear { min-height: 2.75rem; border: 0; background: transparent; color: var(--ink-2); text-decoration: underline; cursor: pointer; font: inherit; font-size: var(--fs-sm); }
  .drawer__clear:hover { color: #b42318; }

  @media (prefers-reduced-motion: reduce) {
    dialog.drawer, dialog.drawer::backdrop { transition: none; }
  }
</style>

<script>
  import { addItem, setQty, removeItem, cartCount, cartTotal, buildOrderMessage, type CartItem } from '../../lib/cart';
  import { CART_STORAGE_KEY, loadCart, saveCart } from '../../lib/cart-storage';
  import { formatPrice } from '../../lib/format';
  import { whatsappHref } from '../../lib/whatsapp';

  const $ = <T extends HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel);
  const drawer = $<HTMLDialogElement>('#cart-drawer');
  const tpl = $<HTMLTemplateElement>('#cart-row-template');
  if (drawer && tpl) init(drawer, tpl);

  function init(drawer: HTMLDialogElement, tpl: HTMLTemplateElement) {
    const maxQty = Number(drawer.dataset.maxQty ?? 99);
    const list = $<HTMLUListElement>('[data-cart-list]', drawer)!;
    const empty = $('[data-cart-empty]', drawer)!;
    const foot = $('[data-cart-foot]', drawer)!;
    const totalEl = $('[data-cart-total]', drawer)!;
    const countLabel = $('[data-cart-count-label]', drawer)!;
    const branch = $<HTMLSelectElement>('[data-cart-branch]', drawer)!;
    const checkout = $<HTMLAnchorElement>('[data-cart-checkout]', drawer)!;
    const live = $('[data-cart-live]')!;

    let items: CartItem[] = loadCart();
    let opener: HTMLElement | null = null;

    const announce = (msg: string) => {
      live.textContent = '';
      requestAnimationFrame(() => (live.textContent = msg));
    };

    const updateCheckout = () => {
      const name = branch.selectedOptions[0]?.textContent ?? '';
      checkout.href = whatsappHref(branch.value, buildOrderMessage(items, name, formatPrice));
    };

    const render = () => {
      const count = cartCount(items);
      document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
        el.textContent = String(count);
        el.hidden = count === 0;
      });
      const cartBtn = $('[data-cart-open]');
      cartBtn?.setAttribute('aria-label', count ? `Abrir carrito, ${count} ${count === 1 ? 'producto' : 'productos'}` : 'Abrir carrito');

      countLabel.textContent = count ? `(${count})` : '';
      empty.hidden = count > 0;
      list.hidden = count === 0;
      foot.hidden = count === 0;
      totalEl.textContent = formatPrice(cartTotal(items));

      list.replaceChildren(
        ...items.map((item) => {
          const row = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
          row.dataset.id = item.id;
          const img = $<HTMLImageElement>('.row__img', row)!;
          img.src = item.image;
          $('.row__name', row)!.textContent = item.name;
          $('.row__unit', row)!.textContent = item.unit;
          $('.row__n', row)!.textContent = String(item.qty);
          $('.row__price', row)!.textContent = formatPrice(item.price * item.qty);
          const dec = $<HTMLButtonElement>('[data-qty-dec]', row)!;
          const inc = $<HTMLButtonElement>('[data-qty-inc]', row)!;
          dec.setAttribute('aria-label', item.qty === 1 ? `Quitar ${item.name}` : `Quitar una unidad de ${item.name}`);
          inc.setAttribute('aria-label', `Agregar una unidad de ${item.name}`);
          inc.disabled = item.qty >= maxQty;
          $('[data-remove]', row)!.setAttribute('aria-label', `Eliminar ${item.name} del carrito`);
          return row;
        }),
      );
      updateCheckout();
    };

    const commit = (next: CartItem[]) => {
      items = next;
      saveCart(items);
      render();
    };

    const open = (from?: HTMLElement | null) => {
      opener = from ?? null;
      if (!drawer.open) drawer.showModal();
    };
    const close = () => drawer.open && drawer.close();

    // Un solo listener delegado para todo el documento
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;

      const addBtn = t.closest<HTMLButtonElement>('[data-add-to-cart]');
      if (addBtn) {
        const d = addBtn.dataset;
        commit(addItem(items, { id: d.id!, name: d.name!, price: Number(d.price), unit: d.unit!, image: d.image! }));
        addBtn.dataset.added = 'true';
        window.setTimeout(() => delete addBtn.dataset.added, 1400);
        const badge = $('.header__badge');
        if (badge) {
          badge.dataset.bump = 'true';
          badge.addEventListener('animationend', () => delete badge.dataset.bump, { once: true });
        }
        announce(`${d.name} agregado al carrito. ${cartCount(items)} en total.`);
        return;
      }

      const openBtn = t.closest<HTMLElement>('[data-cart-open]');
      if (openBtn) return open(openBtn);

      if (t.closest('[data-cart-close]') || t === drawer) return close(); // clic en el fondo cierra

      if (!drawer.contains(t)) return;
      const row = t.closest<HTMLElement>('.row');
      const id = row?.dataset.id;
      if (id && t.closest('[data-qty-inc]')) commit(setQty(items, id, (items.find((i) => i.id === id)?.qty ?? 0) + 1));
      else if (id && t.closest('[data-qty-dec]')) commit(setQty(items, id, (items.find((i) => i.id === id)?.qty ?? 1) - 1));
      else if (id && t.closest('[data-remove]')) commit(removeItem(items, id));
      else if (t.closest('[data-cart-clear]')) commit([]);
    });

    branch.addEventListener('change', updateCheckout);
    drawer.addEventListener('close', () => opener?.focus());
    // Sincroniza entre pestañas
    window.addEventListener('storage', (e) => {
      if (e.key === CART_STORAGE_KEY) {
        items = loadCart();
        render();
      }
    });

    render();
  }
</script>
