---
import { LOCATIONS } from '../../data/site';
import { formatSchedule } from '../../lib/hours';
import { whatsappHref } from '../../lib/whatsapp';
import { formatCount, formatRating } from '../../lib/format';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';

const mapsHref = (lat: number, lng: number) => `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
---

<section id="sucursales" class="section" aria-labelledby="suc-title">
  <div class="container">
    <header class="section__head">
      <p class="section__eyebrow">Dónde estamos</p>
      <h2 id="suc-title" class="section__title">Dos sedes en Córdoba</h2>
      <p class="section__lead">Horarios según Google Maps. Escribile a la sede que te queda más cómoda.</p>
    </header>

    <ul class="locs">
      {LOCATIONS.map((loc) => (
        <li class="loc" data-schedule={JSON.stringify(loc.schedule)}>
          <div class="loc__top">
            <h3>{loc.name}</h3>
            <p class="loc__rating"><Icon name="star" size={16} /> {formatRating(loc.googleRating.value)} <span>({formatCount(loc.googleRating.count)})</span></p>
          </div>
          <p class="loc__role">{loc.role}</p>
          <p class="loc__status" data-status hidden></p>

          <dl class="loc__info">
            <div><dt><Icon name="pin" size={20} label="Dirección" /></dt><dd>{loc.street}<br />{loc.locality}</dd></div>
            <div><dt><Icon name="phone" size={20} label="Teléfono" /></dt><dd><a href={`tel:${loc.phoneHref}`}>{loc.phone}</a></dd></div>
            <div class="loc__hours"><dt><Icon name="clock" size={20} label="Horarios" /></dt>
              <dd>
                <ul>
                  {formatSchedule(loc.schedule).map((row) => (<li><span>{row.days}</span> {row.hours}</li>))}
                </ul>
              </dd>
            </div>
          </dl>

          <div class="loc__cta">
            <Button variant="whatsapp" href={whatsappHref(loc.whatsapp, `Hola Química Dalton (${loc.name}), quiero hacer una consulta.`)} target="_blank" rel="noopener">
              <Icon name="whatsapp" size={20} /> WhatsApp {loc.whatsappLabel}
            </Button>
            <Button variant="ghost" href={mapsHref(loc.coords.lat, loc.coords.lng)} target="_blank" rel="noopener">Cómo llegar</Button>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .locs { display: grid; gap: 1.25rem; }
  .loc { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; background: #fff; display: grid; gap: 0.75rem; align-content: start; }
  .loc__top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
  .loc h3 { font-size: 1.9rem; text-transform: uppercase; color: var(--blue-dark); }
  .loc__rating { display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 700; color: #7a5200; background: #fff4d6; padding: 0.15rem 0.7rem; border-radius: 999px; font-size: var(--fs-sm); }
  .loc__rating :global(svg) { fill: var(--yellow); stroke: var(--yellow); }
  .loc__rating span { font-weight: 500; }
  .loc__role { color: var(--ink-2); }
  .loc__status { font-weight: 700; font-size: var(--fs-sm); padding: 0.25rem 0.75rem; border-radius: 999px; justify-self: start; }
  .loc__status[data-open='true'] { background: #dcf7e6; color: #0a6b34; }
  .loc__status[data-open='false'] { background: #eef1f5; color: var(--ink-2); }
  .loc__info { display: grid; gap: 0.7rem; margin: 0.25rem 0; }
  .loc__info > div { display: flex; gap: 0.75rem; align-items: flex-start; }
  .loc__info dt { flex-shrink: 0; color: var(--blue); margin-top: 0.15rem; }
  .loc__info dd { margin: 0; }
  .loc__hours ul { display: grid; gap: 0.15rem; }
  .loc__hours span { display: inline-block; min-width: 4.8rem; font-weight: 600; }
  .loc__cta { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.5rem; }
  .loc a:not(.btn) { color: var(--blue); font-weight: 600; }
  @media (min-width: 48rem) { .locs { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  import { getOpenStatus } from '../../lib/hours';
  import type { Schedule } from '../../types';

  const update = () => {
    document.querySelectorAll<HTMLElement>('.loc[data-schedule]').forEach((el) => {
      const badge = el.querySelector<HTMLElement>('[data-status]');
      if (!badge) return;
      const status = getOpenStatus(JSON.parse(el.dataset.schedule ?? '{}') as Schedule, new Date());
      badge.textContent = status.text;
      badge.dataset.open = String(status.open);
      badge.hidden = false;
    });
  };
  update();
  setInterval(update, 60_000);
</script>
