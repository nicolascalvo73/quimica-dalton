---
import { storeHref } from '../../lib/url';
import Icon from '../ui/Icon.astro';

const STEPS = [
  { icon: 'box', title: 'Elegí', text: 'Mirá el catálogo online o consultanos por WhatsApp qué necesitás.' },
  { icon: 'whatsapp', title: 'Pedí tu presupuesto', text: 'Te respondemos con precio, stock y cantidades mínimas si aplica.' },
  { icon: 'truck', title: 'Retirá o recibí', text: 'Pasá por la fábrica o por Centro, o coordinamos el envío.' },
] as const;
---

<section id="como-comprar" class="section" aria-labelledby="como-title">
  <div class="container">
    <header class="section__head">
      <p class="section__eyebrow">Cómo comprar</p>
      <h2 id="como-title" class="section__title">Tres pasos, sin vueltas</h2>
    </header>
    <ol class="steps">
      {STEPS.map((s, i) => (
        <li class="step">
          <span class="step__num" aria-hidden="true">{i + 1}</span>
          <span class="step__icon"><Icon name={s.icon} size={28} /></span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    <p class="steps__note">¿Preferís comprar online? <a href={storeHref()}>Entrá a la tienda</a>.</p>
  </div>
</section>

<style>
  .steps { display: grid; gap: 1rem; counter-reset: s; }
  .step { position: relative; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; display: grid; gap: 0.5rem; justify-items: start; }
  .step__num { position: absolute; top: 0.9rem; right: 1.1rem; font-family: var(--font-display); font-weight: 800; font-size: 3.5rem; line-height: 1; color: var(--blue-tint); }
  .step__icon { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 12px; background: var(--blue-tint); color: var(--blue); }
  .step h3 { font-size: 1.6rem; text-transform: uppercase; }
  .step p { color: var(--ink-2); }
  .steps__note { margin-top: 1.5rem; color: var(--ink-2); }
  .steps__note a { color: var(--blue); font-weight: 700; }
  @media (min-width: 48rem) { .steps { grid-template-columns: repeat(3, 1fr); } }
</style>
