---
import { Image } from 'astro:assets';
import type { Product } from '../../types';
import { lineById } from '../../data/lines';
import { getImage } from '../../lib/images';
import { formatPrice } from '../../lib/format';
import { storeHref } from '../../lib/url';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const line = lineById(product.lineId);
---

<article class="card" style={`--line-color: ${line?.color ?? 'var(--blue)'}`}>
  <div class="card__media">
    <Image src={getImage(product.image)} alt={product.imageAlt} widths={[230, 460]} sizes="(min-width: 64rem) 16rem, (min-width: 40rem) 45vw, 45vw" loading="lazy" />
    {product.badge && <span class="card__badge">{product.badge}</span>}
  </div>
  <div class="card__body">
    <p class="card__line">{line?.name}</p>
    <h3 class="card__name">{product.name}</h3>
    <p class="card__desc">{product.description}</p>
    <p class="card__price">
      <strong>{formatPrice(product.price)}</strong>
      <span>{product.unit}</span>
    </p>
    <a class="card__cta" href={storeHref(`/productos/${product.id}`)} aria-label={`Ver ${product.name} en la tienda`}>
      Ver producto
    </a>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; height: 100%; transition: box-shadow 0.2s ease, transform 0.2s ease; }
  .card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .card__media { position: relative; aspect-ratio: 230 / 150; background: #fff; border-bottom: 4px solid var(--line-color); }
  .card__media :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .card__badge { position: absolute; top: 0.6rem; left: 0.6rem; background: var(--yellow); color: var(--ink); font-size: 0.75rem; font-weight: 700; padding: 0.15rem 0.6rem; border-radius: 999px; }
  .card__body { display: flex; flex-direction: column; gap: 0.3rem; padding: 0.75rem 0.8rem 0.9rem; flex: 1; }
  .card__line { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--line-color); filter: brightness(0.8); }
  .card__name { font-size: 1.15rem; text-transform: uppercase; }
  .card__desc { display: none; color: var(--ink-2); font-size: var(--fs-sm); }
  .card__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.1rem 0.5rem; margin-top: auto; padding-top: 0.4rem; }
  .card__price strong { font-family: var(--font-display); font-size: 1.45rem; font-weight: 800; }
  .card__price span { color: var(--ink-2); font-size: var(--fs-sm); }
  .card__cta { margin-top: 0.5rem; align-self: flex-start; font-weight: 700; color: var(--blue); text-decoration: none; padding: 0.55rem 0; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .card__cta::after { content: ' →'; margin-left: 0.3rem; transition: transform 0.15s; }
  .card__cta:hover { text-decoration: underline; }
  @media (min-width: 40rem) {
    .card__body { padding: 1rem 1.1rem 1.2rem; gap: 0.35rem; }
    .card__name { font-size: 1.4rem; }
    .card__desc { display: block; flex: 1; }
    .card__price strong { font-size: 1.6rem; }
  }
</style>
